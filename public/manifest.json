{
  "name": "Pixel Prowler",
  "version": "0.1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pixel Prowler"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "system.display",
    "tts",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "contextMenus",
    "offscreen",
    "pageCapture",
    "windows",
    "webRequest",
    "webRequestBlocking",
    "processes",
    "runtime",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "onnx_worker.js",
        "offscreen.html",
        "offscreen.js",
        "notification.js",
        "notification.html",
        "utils.js",
        "models/*",
        "libs/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  }
}
