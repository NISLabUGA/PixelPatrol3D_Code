{
  "manifest_version": 2,
  "name": "Pixel Prowler",
  "version": "0.1.0",
  "description": "Detects and analyzes screenshots for social engineering attacks.",

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Pixel Prowler"
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "permissions": [
    "system.display",
    "tts",
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "downloads",
    "contextMenus",
    "pageCapture",
    "windows",
    "webRequest",
    "webRequestBlocking",
    "runtime",
    "notifications",
    "<all_urls>"
  ],

  "content_security_policy": "script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net; object-src 'self'; worker-src blob:",

  "web_accessible_resources": [
    "onnx_worker.js",
    "offscreen.html",
    "offscreen.js",
    "notification.html",
    "notification.js",
    "sandbox.html",
    "utils.js",
    "models/*",
    "libs/*"
  ]
}
